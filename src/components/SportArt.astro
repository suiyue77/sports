---
const {sport}=Astro.props;
---
<div class={`sport-art ${sport.accent}`} aria-hidden="true">
{sport.id==='volleyball'?<svg viewBox="0 0 260 150" fill="none" stroke="currentColor" stroke-width="2"><rect x="18" y="18" width="224" height="114" rx="2"/><path d="M130 18v114M92 18v114M168 18v114" stroke-dasharray="4 5"/><path d="M130 10v130" stroke-width="4"/>{[[42,45],[42,105],[78,75],[111,44],[111,106],[105,75],[149,44],[149,106],[155,75],[182,75],[218,45],[218,105]].map(([x,y])=><circle cx={x} cy={y} r="6" fill="currentColor" stroke="none"/>)}</svg>:sport.id==='fitness'?<svg viewBox="0 0 260 150" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"><path d="M48 75h164"/><rect x="42" y="53" width="12" height="44" rx="4"/><rect x="58" y="37" width="20" height="76" rx="5"/><rect x="82" y="27" width="22" height="96" rx="5"/><rect x="156" y="27" width="22" height="96" rx="5"/><rect x="182" y="37" width="20" height="76" rx="5"/><rect x="206" y="53" width="12" height="44" rx="4"/></svg>:<svg viewBox="0 0 260 150" fill="none" stroke="currentColor" stroke-width="2"><path d="M130 138L30 38Q130 -32 230 38Z"/><path d="M130 123L78 71l52-52 52 52Z" fill="#ded0b4"/><path d="M130 123L78 71l52-52 52 52Z"/><circle cx="130" cy="70" r="10" stroke-dasharray="3 3"/>{[[130,19],[78,71],[182,71],[130,123]].map(([x,y])=><rect x={x-5} y={y-5} width="10" height="10" fill="currentColor" transform={`rotate(45 ${x} ${y})`}/>)}</svg>}
</div>
