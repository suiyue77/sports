---
import Base from '../../layouts/Base.astro';
import {readSite} from '../../lib/agent-reader';
const site=await readSite();
---
<Base title="站点索引" description={site.description}><article class="article" aria-labelledby="reader-title"><p class="eyebrow">公开站点索引</p><h1 id="reader-title" class="">{site.title} · Agent Reader</h1><p class="lead">{site.description}</p><p class="my-4"><a class="underline" href={site.home}>返回网站</a> · <a class="underline" href={site.source}>公开源码</a> · <a class="underline" href={new URL('agent/site.json',site.home)}>JSON</a></p><div class="prose">{site.sections.map(s=><section><h2 class=""><a class="underline" href={s.url}>{s.title}</a></h2><p>{s.description}</p>{'reference' in s&&s.reference&&<p><a class="underline" href={s.reference.url}>{s.reference.title}</a></p>}<ul class="list-disc pl-6 space-y-2">{s.items.map(i=><li><a class="underline break-words" href={i.url}>{i.title}</a> — {i.description}</li>)}</ul></section>)}<section><h2 class="">使用边界</h2><ul class="list-disc pl-6">{site.limitations.map(t=><li>{t}</li>)}</ul></section></div></article></Base>
