---
import Base from '../layouts/Base.astro';
import {sports} from '../data/sports';
import SportArt from '../components/SportArt.astro';
import ArticleList from '../components/ArticleList.astro';
import {getCollection} from 'astro:content';
const guides=await getCollection('guides');
const featured=sports.map(s=>guides.find(g=>g.data.sport===s.id&&g.data.number===1)!).filter(Boolean);
---
<Base><section class="hero"><div class="hero-panel"><div><p class="eyebrow">THE FIELD GUIDE / 运动手册</p><h1>去运动，<br/>懂运动。</h1><p class="lead">从排球、健身到棒球。把规则、技术和训练经验整理成可以反复查阅的知识。</p><div class="hero-links">{sports.map(s=><a href={`/${s.id}/`}>{s.name} →</a>)}</div></div><div class="hero-visual" aria-hidden="true"><svg viewBox="0 0 320 260" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="20" y="20" width="280" height="220" rx="2"/><path d="M160 20v220M20 130h280M90 20v220M230 20v220" opacity=".4"/><circle cx="160" cy="130" r="94"/><circle cx="160" cy="130" r="64"/><path d="M160 42L248 130l-88 88-88-88Z"/><circle cx="160" cy="130" r="8" fill="currentColor"/><path d="M20 20h20M20 20v20M300 240h-20M300 240v-20" stroke-width="4"/><path d="M160 65l0 130M95 130h130" stroke-dasharray="3 6"/></svg></div></div></section><section class="section"><div class="section-head"><div><p class="eyebrow">01 / Explore</p><h2>三个运动，三条学习路径</h2></div><span class="note">从基础开始</span></div><div class="sport-grid">{sports.map(s=><a class="sport-card" href={`/${s.id}/`}><SportArt sport={s}/><span class="eyebrow">{s.number} / {s.en}</span><h3>{s.name}</h3><p class="desc">{s.description}</p><span class="text-link">进入栏目 →</span></a>)}</div></section><section class="section"><div class="section-head"><div><p class="eyebrow">02 / Start here</p><h2>第一批入门指南</h2></div></div><ArticleList guides={featured}/></section></Base>
